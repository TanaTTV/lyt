{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tanattv/lyt/blob/main/schemas/lyt.info.v1.schema.json",
  "title": "lyt info v1",
  "type": "object",
  "required": ["schema", "version", "command", "ok", "results"],
  "properties": {
    "schema": { "const": "lyt.info.v1" },
    "version": { "type": "string" },
    "command": { "const": "info" },
    "ok": { "type": "boolean" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "status"],
        "properties": {
          "url": { "type": "string" },
          "status": { "enum": ["available", "failed"] },
          "id": { "type": ["string", "null"] },
          "extractor": { "type": ["string", "null"] },
          "title": { "type": "string" },
          "uploader": { "type": ["string", "null"] },
          "durationSeconds": { "type": ["number", "null"] },
          "isLive": { "type": "boolean" },
          "thumbnail": { "type": ["string", "null"] },
          "webpageUrl": { "type": ["string", "null"] },
          "heights": { "type": "array", "items": { "type": "integer" } },
          "audioBitrates": { "type": "array", "items": { "type": "integer" } },
          "formats": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "formatId": { "type": ["string", "null"] },
                "ext": { "type": ["string", "null"] },
                "height": { "type": ["integer", "null"] },
                "fps": { "type": ["number", "null"] },
                "vcodec": { "type": ["string", "null"] },
                "acodec": { "type": ["string", "null"] },
                "abr": { "type": ["integer", "null"] },
                "filesize": { "type": ["integer", "null"] },
                "note": { "type": ["string", "null"] }
              },
              "additionalProperties": true
            }
          },
          "error": { "$ref": "#/$defs/error" }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "error": {
      "type": "object",
      "required": ["message", "code"],
      "properties": {
        "message": { "type": "string" },
        "code": { "type": "integer" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
